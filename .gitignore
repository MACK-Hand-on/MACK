# ---------------------------------------------------------------- Terraform
.terraform/
*.tfstate
*.tfstate.*
tfplan
plan.txt
crash.log

# ------------------------------------------- Nunca versionar credenciais
*-key.json
*credentials*.json
service-account*.json
.env
*.pem

# ---------------------------------------------------------------- Dados
# A base versionada e a comprimida, em 2_dados/atual_v8/*.csv.gz (13 MB).
# Os CSVs descompactados somam 101 MB e sao derivados - nao entram no Git.
# Ver 2_dados/LEIA-ME.md para descompactar ou regerar.
2_dados/**/*.csv
!2_dados/amostras/*.csv

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------- Diversos
*.bak
.DS_Store
Thumbs.db

# ------------------------------------------------- Saidas do treino
# O 08_modelo_estagio1.py gera o modelo e as predicoes em segundos. O .joblib
# e binario de 1 MB e quebra quando a versao do scikit-learn muda; as
# predicoes sao 910 KB derivados. Versionado fica so o .txt de metricas.
7_modelo/*.joblib
7_modelo/estagio1_predicoes_teste.csv
